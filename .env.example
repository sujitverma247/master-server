DATABASE_URL=Host=localhost;Port=5432;Database=master;Username=postgres;Password=postgres
POSTGRES_PASSWORD=postgres
PRODUCT_SLUG=
PRODUCT_DISPLAY_NAME=
PRODUCT_APP_KEY=
PRODUCT_KEY_PREFIX=
PRODUCT_USER_AGENT_PREFIX=
PRODUCT_HMAC_SECRET=
SEED_LICENSE_KEY=
SEED_PLAN_TYPE=1year
SEED_MAX_MACHINES=3

# ── Admin panel API (Phase 1) ─────────────────
# First admin is created only when no admin users exist yet.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_DISPLAY_NAME=
# Comma-separated origins allowed to call /admin/* from a browser. Empty = no browser CORS.
ADMIN_ORIGIN=
ADMIN_SESSION_HOURS=12

# ── Payments (Phase 5) ────────────────────────
# Default adapter: "dev" (signed local webhook) or "manual" (admin mark-paid).
# Real provider catalog ids belong in GatewayPlan rows, not here.
GATEWAY_DEFAULT=dev
GATEWAY_DEV_SECRET=

# ── Mail (Phase 6) ────────────────────────────
# console = outbox marked sent with no network. smtp = MAIL_SMTP_*.
# From-address falls back to Brand.SupportEmail when set on the product's brand.
MAIL_PROVIDER=console
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_STARTTLS=true
